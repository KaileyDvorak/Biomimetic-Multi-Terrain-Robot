#include <SFML/Graphics.hpp>
#include <cmath>
#include <iostream>
#include <thread>
#include <chrono>

const int WINDOW_WIDTH = 800;
const int WINDOW_HEIGHT = 600;
const int DIAMETER = 18;
const int LEG_LENGTH = 50;
const int NUM_LEGS = 4;
const int DEGREES_OF_FREEDOM = 12;
const float PI = 3.14159265359f;

class RobotLeg {
private:
    sf::RectangleShape segments[DEGREES_OF_FREEDOM];
    float angles[DEGREES_OF_FREEDOM];
    sf::Vector2f positions[DEGREES_OF_FREEDOM];

public:
    RobotLeg(float x, float y) {
        for (int i = 0; i < DEGREES_OF_FREEDOM; ++i) {
            segments[i].setSize(sf::Vector2f(10, 50));
            segments[i].setFillColor(sf::Color::White);
            segments[i].setOrigin(5, 0);
            positions[i] = sf::Vector2f(x, y);
        }
    }

    void update() {
        for (int i = 0; i < DEGREES_OF_FREEDOM; ++i) {
            angles[i] += 1.0f;
            float angle_radians = angles[i] * PI / 180.0f;
            positions[i].x += cos(angle_radians) * 10;
            positions[i].y += sin(angle_radians) * 10;
            segments[i].setPosition(positions[i]);
        }
    }

    void draw(sf::RenderWindow& window) {
        for (int i = 0; i < DEGREES_OF_FREEDOM; ++i) {
            window.draw(segments[i]);
        }
    }
};

int main() {
    sf::RenderWindow window(sf::VideoMode(WINDOW_WIDTH, WINDOW_HEIGHT), "Robot Leg Curling into a Circle");

    RobotLeg legs[NUM_LEGS] = {
        RobotLeg(200, 200),
        RobotLeg(400, 200),
        RobotLeg(200, 400),
        RobotLeg(400, 400)
    };

    while (window.isOpen()) {
        sf::Event event;
        while (window.pollEvent(event)) {
            if (event.type == sf::Event::Closed)
                window.close();
        }

        window.clear();

        for (int i = 0; i < NUM_LEGS; ++i) {
            legs[i].update();
            legs[i].draw(window);
        }

        window.display();

        std::this_thread::sleep_for(std::chrono::milliseconds(50)); // Adjust the sleep time as needed
    }

    return 0;
}
